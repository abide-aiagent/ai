# ========================================
# AI Agent Server — Environment Variables
# ========================================

# PostgreSQL connection string (used by psycopg async pool)
DATABASE_URL=YOUR_VALUE_HERE

# Redis connection URL (used for session state persistence)
REDIS_URL=YOUR_VALUE_HERE

# OpenAI API key (optional — not actively used; Gemini is the primary LLM)
OPENAI_API_KEY=YOUR_VALUE_HERE

# Google Gemini API key (primary LLM and embedding provider)
GEMINI_API_KEY=YOUR_VALUE_HERE

# Port the FastAPI server listens on (default: 8000)
AI_SERVER_PORT=8000

# URL of the core backend server (Rust/Go) for cross-service calls
CORE_SERVER_URL=http://localhost:8080

# Logging level: debug | info | warning | error (default: info)
LOG_LEVEL=info
